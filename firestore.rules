rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The pairing code is a possession-based demo credential. It is random,
    // short-lived in practice, and only exposes the anonymous user ids here.
    match /pairs/{pairId} {
      allow create: if request.auth != null
                    && request.resource.data.survivorUid == request.auth.uid;

      // A caregiver must read the exact code entered by the user before it can
      // claim the pair. The state document below remains member-only.
      allow get: if request.auth != null;
      allow list: if false;

      allow update: if request.auth != null
                    && request.resource.data.survivorUid == resource.data.survivorUid
                    && (
                      resource.data.survivorUid == request.auth.uid
                      || request.resource.data.caregiverUid == request.auth.uid
                    );
      allow delete: if request.auth != null
                    && resource.data.survivorUid == request.auth.uid;

      match /state/{stateId} {
        allow read, write: if request.auth != null
                          && (
                            get(/databases/$(database)/documents/pairs/$(pairId)).data.survivorUid == request.auth.uid
                            || get(/databases/$(database)/documents/pairs/$(pairId)).data.caregiverUid == request.auth.uid
                          );
      }
    }
  }
}
